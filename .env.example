# Modelo das configurações. NUNCA coloque valores reais aqui.
# No servidor, os valores reais ficam em /etc/assistente/site.env
# (veja docs/servidor.md, seção 4).

# Endereço público do site (usado em links de e-mail e redirecionamentos)
SITE_URL=https://sc.hayahtraining.com

# As próximas etapas vão acrescentar aqui:
#   NEXT_PUBLIC_SUPABASE_URL=        (Supabase > Project Settings > API)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=   (Supabase > Project Settings > API Keys)
#   SUPABASE_SERVICE_ROLE_KEY=       (chave mestra: só no servidor)
#   RESEND_API_KEY=                  (Resend > API Keys)
#   GEMINI_API_KEY=                  (Google AI Studio > Get API key)
#   NUMEROS_PERMITIDOS=              (opcional; vazio = todos os aprovados)
