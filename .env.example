# Modelo das configurações. NUNCA coloque valores reais aqui.
# No servidor, os valores reais ficam em /etc/assistente/site.env e são
# cadastrados com o comando: assistente-configurar   (docs/servidor.md, seção 4)

# Endereço público do site (links de e-mail e redirecionamentos usam este valor)
SITE_URL=https://sc.hayahtraining.com

# Supabase > Project Settings > Data API > Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
# Chave mestra usada só pelo robô, só no servidor.
SUPABASE_SECRET_KEY=

# Google AI Studio > Get API key (com pagamento ativado e teto de gastos)
GEMINI_API_KEY=

# Opcional: só estes números conversam com o robô (separados por vírgula).
# Vazio = todos os cadastros aprovados.
NUMEROS_PERMITIDOS=

# Gerada sozinha pelo servidor na publicação (não precisa preencher):
# chave que criptografa as senhas do e-mail e da agenda.
CONEXOES_CHAVE=

# Opcional: login do Google para a agenda (marcar/mudar/cancelar compromissos).
# Google Cloud Console > Google Auth Platform > Clientes > (seu cliente Web).
# Cadastre no servidor com: assistente-configurar GOOGLE_CLIENT_ID (e depois GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
